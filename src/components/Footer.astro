---
import en from "../i18n/en.json";
import nl from "../i18n/nl.json";

const { lang } = Astro.props as { lang: "en" | "nl" };
const t = lang === "nl" ? nl : en;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <div class="name">{t.brand}</div>
    <p class="tagline">{t.footer.tagline}</p>
    <div class="links mono">
      <a href="https://instagram.com" target="_blank" rel="noreferrer">Instagram</a>
      <a href="https://linkedin.com" target="_blank" rel="noreferrer">LinkedIn</a>
      <a href="https://printables.com" target="_blank" rel="noreferrer">Printables</a>
      <a href="https://makerworld.com" target="_blank" rel="noreferrer">MakerWorld</a>
      <a href="https://github.com" target="_blank" rel="noreferrer">GitHub</a>
    </div>
    <div class="copyright mono">&copy; {year}</div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
    padding: 72px var(--side-margin) 48px;
    margin-top: 96px;
  }

  .inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .name {
    font-family: var(--font-heading);
    font-size: 40px;
  }

  .tagline {
    margin-top: 8px;
    color: var(--body-2);
  }

  .links {
    display: flex;
    gap: 16px;
    margin-top: 32px;
  }

  .links a {
    text-decoration: none;
    color: var(--navy);
  }

  .links a:hover {
    color: var(--moss);
  }

  .copyright {
    margin-top: 24px;
    color: var(--stone);
  }
</style>
